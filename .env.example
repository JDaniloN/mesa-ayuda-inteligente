# Copiar a `.env` y rellenar. `.env` no se versiona (está en .gitignore).
# Precedencia: sistema/GitHub/Docker > `.env` > valores predeterminados.

# API propia (etapa 2). Bearer de Swagger Authorize; no es la clave de OpenAI.
API_TOKEN=demo-api-local
API_HOST=127.0.0.1
API_PORT=8000

# Servicio mock local (materiales/servicio_mock). El valor de prueba
# está en materiales/servicio_mock/README.md.
MOCK_URL=http://localhost:8080
MOCK_TOKEN=demo-token-prueba-2026
MOCK_TIMEOUT=5

# Proveedor de IA (OpenAI o compatible /v1/chat/completions).
# Sin IA_API_KEY el POST igual responde 201 con origen=degradado.
IA_API_BASE_URL=https://api.openai.com/v1
IA_API_KEY=
IA_MODEL=gpt-4o-mini
IA_TIMEOUT=8
IA_REINTENTOS=1
IA_EMBEDDING_MODEL=text-embedding-3-small

# RAG (etapa 3). RAG_MIN_SCORE es provisional; se calibra en el ítem de abstención.
RAG_MIN_SCORE=0.22
RAG_INDICE_DIR=data/salida/rag

# App
APP_ENV=development
LOG_LEVEL=INFO
